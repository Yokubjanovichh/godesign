---
const quote = 'Мы становимся собой, когда создаём пространство под себя.';
const words = quote.split(' ');
// подсветим ключевые слова акцентом
const accentWords = new Set(['пространство', 'под', 'себя.']);
---

<section class="manifesto" id="manifesto" data-manifesto>
  <div class="container-narrow">
    <p class="eyebrow reveal">Философия</p>

    <p class="manifesto-quote serif">
      {
        words.map((w) => (
          <span
            class:list={['mf-word', { 'mf-accent': accentWords.has(w.toLowerCase()) }]}
          >
            {w}{' '}
          </span>
        ))
      }
    </p>

    <p class="manifesto-sub reveal">
      Пространство — как отражение пути. Родовое гнездо, где хранится память
      поколений. Новый дом, который становится точкой отсчёта. Каждый раз мы
      задаём себе одни и те же вопросы: как здесь будет жить моя семья? Что
      оставить, а что — отпустить?
    </p>
  </div>
</section>

<style>
  .manifesto {
    padding-block: clamp(6rem, 16vh, 12rem);
  }
  .manifesto-quote {
    font-size: clamp(2rem, 5.2vw, 4.4rem);
    font-weight: 330;
    line-height: 1.16;
    letter-spacing: -0.02em;
    margin-top: 1.8rem;
    max-width: 22ch;
  }
  .mf-word {
    display: inline;
  }
  .mf-accent {
    font-style: italic;
    color: var(--c-accent);
  }
  .manifesto-sub {
    max-width: 54ch;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
    font-size: 1.08rem;
    color: var(--c-ink-soft);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initManifesto() {
    const section = document.querySelector<HTMLElement>('[data-manifesto]');
    if (!section || section.dataset.mfReady) return;
    const words = section.querySelectorAll('.mf-word');
    if (!words.length) return;
    section.dataset.mfReady = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.fromTo(
      words,
      { opacity: 0.16 },
      {
        opacity: 1,
        ease: 'none',
        stagger: 0.5,
        scrollTrigger: {
          trigger: section,
          start: 'top 68%',
          end: 'center 42%',
          scrub: 0.6,
        },
      }
    );
  }

  initManifesto();
  document.addEventListener('astro:page-load', initManifesto);
</script>
