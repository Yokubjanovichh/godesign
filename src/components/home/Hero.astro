---
import { getImage } from 'astro:assets';
// Тёплый кадр «Загородного семейного клуба», развёрнутый правее — на золотистую
// панель; телевизор срезан (см. scripts/make-hero.mjs, просьба Ольги).
// Два варианта: на широком экране вертикальный кадр обрезался бы почти на 2/3.
import heroWide from '../../assets/hero/semeyny-wide.webp';
import heroTall from '../../assets/hero/semeyny-tall.webp';

// Крупнее и качественнее: на мониторе 1920 самый широкий вариант был 1560 px
// и его растягивало — картинка рассыпалась в зерно («шумы» у Ольги).
const wide = await getImage({
  src: heroWide,
  widths: [1280, 1600, 2000],
  format: 'webp',
  quality: 88,
});
const tall = await getImage({
  src: heroTall,
  widths: [640, 900, 1200],
  format: 'webp',
  quality: 80,
});
---

<section class="hero" data-hero>
  <div class="hero-media" data-hero-clip>
    <div class="hero-img-scale" data-hero-img>
      <picture>
        <!-- Горизонтальный кадр — только когда экран действительно широкий.
             По ширине выбирать нельзя: у планшета книжкой ширина 820 px, но
             экран вытянут вверх, и широкий кадр обрезался в узкую полосу. -->
        <source media="(min-aspect-ratio: 4/3)" srcset={wide.srcSet.attribute} sizes="100vw" />
        <img
          src={tall.src}
          srcset={tall.srcSet.attribute}
          sizes="100vw"
          width={tall.attributes.width}
          height={tall.attributes.height}
          alt="Загородный семейный клуб — тёплый интерьер, проект Ольги Горчаковой"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-img"
        />
      </picture>
    </div>
    <div class="hero-veil"></div>
  </div>

  <div class="container hero-inner">
    <p class="hero-eyebrow" data-hero-fade>
      <span class="dot"></span>Дизайн интерьера — Москва и МО
    </p>

    <h1 class="hero-title">
      <span class="ln"><span class="wd" data-hero-word>Пространство</span></span>
      <span class="ln"
        ><span class="wd" data-hero-word>как</span>
        <span class="wd serif italic accent" data-hero-word>отражение</span></span
      >
      <span class="ln"><span class="wd" data-hero-word>пути</span></span>
    </h1>

    <div class="hero-foot">
      <p class="hero-lead" data-hero-fade>
        Продуманные и живые интерьеры, в которых человек становится собой.
      </p>
      <a href="#manifesto" class="hero-scroll" data-hero-fade aria-label="Прокрутите вниз">
        <span class="hero-scroll-track"><span class="hero-scroll-thumb"></span></span>
        <span class="hero-scroll-label">Прокрутите</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 40rem;
    overflow: hidden;
    color: #f6efe4;
  }
  /* --- Медиа --- */
  .hero-media {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 0);
  }
  /* Раньше здесь был запас -2 % под параллакс. Вместе с наездом Ken Burns
     (1.05) он давал ~9 % увеличения, и верх панели с подсветкой уходил за
     край — кадр переставал совпадать с ТЗ. Показываем ровно то, что в файле. */
  .hero-img-scale {
    position: absolute;
    inset: 0;
  }
  /* <picture> — обёртка без собственной высоты: без этого height:100 % у <img>
     не к чему привязаться, и кадр вылезает за рамку, обрезая мебель */
  .hero-img-scale picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  /* Широкий кадр (2000×1230) чуть ниже пропорций монитора, поэтому по высоте
     его немного подрезает. Смещаем точку кадрирования вверх: сверху лежат
     подсветка и волнистый верх панели — Ольга просила, чтобы они были видны;
     снизу теряются только ножки кресел. */
  @media (min-width: 768px) {
    .hero-img {
      object-position: center 10%;
    }
  }

  /* Вертикальный экран (телефон, планшет книжкой): высота задаётся
     пропорциями самого снимка, а не экраном, — комната видна целиком.
     Блок идёт ПОСЛЕ .hero-img-scale: у равной специфичности побеждает
     последнее правило, иначе inset: -2 % возвращал обрезку по краям. */
  @media (max-aspect-ratio: 4/3) {
    .hero {
      height: auto;
      /* ровно пропорции semeyny-tall.webp (1560×2000) — при object-fit: cover
         это значит «ни одного срезанного пикселя» */
      aspect-ratio: 39 / 50;
      max-height: 94svh;
      min-height: 30rem;
    }
    /* без запаса под параллакс — кадр показываем целиком */
    .hero-img-scale {
      inset: 0;
    }
    .hero-img {
      object-position: center center;
    }
    /* Текст на вертикальном экране лежит внизу — там вуаль и делаем плотнее,
       а верх кадра (панель, мебель) оставляем светлым.
       Затемнение доведено до 75 % высоты: правый край строки «— Москва и МО»
       попадал на светлое окно и белые буквы там пропадали. */
    .hero-veil {
      background:
        linear-gradient(
          to top,
          rgba(28, 18, 9, 0.82) 0%,
          rgba(28, 18, 9, 0.62) 30%,
          rgba(28, 18, 9, 0.34) 55%,
          rgba(28, 18, 9, 0.12) 75%,
          transparent 92%
        ),
        linear-gradient(100deg, rgba(28, 18, 9, 0.3) 0%, rgba(28, 18, 9, 0.08) 50%, transparent 80%);
    }
  }

  /* Тёплая вуаль: плотнее слева-снизу, где лежит текст, и почти прозрачная
     справа — заголовок больше не сливается со светлой панелью
     (по замечанию Ольги «сливается цвет, поменять») */
  /* Вуаль заметно ослаблена: было 0.74 слева, и Ольга написала «темновато,
     не видна панель». Читаемость заголовка теперь держит тень букв, а не
     затемнение всего кадра. */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(28, 18, 9, 0.52) 0%,
        rgba(28, 18, 9, 0.34) 26%,
        rgba(28, 18, 9, 0.14) 48%,
        rgba(28, 18, 9, 0.03) 68%,
        transparent 84%
      ),
      linear-gradient(to top, rgba(28, 18, 9, 0.42) 0%, rgba(28, 18, 9, 0.1) 44%, transparent 76%);
  }
  /* Плёночное зерно поверх кадра убрано: именно его Ольга увидела как
     «шумы на фото». Рендер чистый, добавлять на него шум незачем. */

  /* --- Контент --- */
  .hero-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
    padding-top: 7rem;
    /* Тень вместо плотной вуали: кадр остаётся светлым, а текст читается */
    text-shadow:
      0 1px 3px rgba(26, 16, 8, 0.55),
      0 2px 30px rgba(26, 16, 8, 0.75);
  }
  .hero-eyebrow {
    display: flex;
    flex-wrap: wrap; /* «— Москва и МО» на узком экране переносится, а не режется */
    align-items: center;
    gap: 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: clamp(1.5rem, 3vw, 2.4rem);
  }
  .hero-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 4px rgba(169, 106, 68, 0.25);
  }

  .hero-title {
    font-family: var(--f-display);
    font-weight: 400;
    /* Было 7.4vw / до 7rem. Ольга: заголовок против логотипа и вертикальной
       подписи смотрелся непропорционально — «нужно добиться гармонии». */
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hero-title .ln {
    display: block;
    overflow: hidden;
    /* Расширяем клип вниз, чтобы не срезались хвосты букв (у, р),
       и компенсируем отрицательным margin — межстрочность прежняя */
    padding-bottom: 0.2em;
    margin-bottom: -0.16em;
  }
  .hero-title .wd {
    display: inline-block;
    will-change: transform;
  }
  /* Пробел между словами в строке (compressHTML убирает пробелы между тегами) */
  .hero-title .wd + .wd {
    margin-left: 0.25em;
  }
  .hero-title .accent {
    font-weight: 400;
    color: #d68a5f;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }
  .hero-lead {
    max-width: 34ch;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(246, 239, 228, 0.82);
  }

  /* --- Скролл-индикатор --- */
  .hero-scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    flex-shrink: 0;
  }
  .hero-scroll-track {
    width: 1px;
    height: 54px;
    background: rgba(246, 239, 228, 0.3);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: #f6efe4;
    animation: heroScroll 2.2s var(--ease) infinite;
  }
  @keyframes heroScroll {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(250%); }
  }
  .hero-scroll-label {
    /* было 0.62rem — на фоне крупного заголовка подпись терялась */
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(246, 239, 228, 0.7);
    writing-mode: vertical-rl;
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.6rem;
    }
    .hero-scroll {
      flex-direction: row;
      align-items: center;
    }
    .hero-scroll-track {
      width: 40px;
      height: 1px;
    }
    .hero-scroll-thumb {
      width: 40%;
      height: 100%;
      animation: heroScrollH 2.2s var(--ease) infinite;
    }
    .hero-scroll-label {
      writing-mode: horizontal-tb;
    }
    @keyframes heroScrollH {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(250%); }
    }
  }

  /* --- Телефон -----------------------------------------------------------
     Текст остаётся поверх кадра, как и на большом экране. Здесь только то,
     что не помещалось: строка «— Москва и МО» упиралась в край. */
  @media (max-width: 640px) {
    /* Кадр показан целиком, поэтому текст ложится и на светлые места —
       на окно справа. Вуаль там слабая (иначе потемнеет вся комната),
       так что читаемость держим тенью самого текста. */
    .hero-inner {
      text-shadow:
        0 1px 2px rgba(26, 16, 8, 0.75),
        0 2px 16px rgba(26, 16, 8, 0.9);
    }
    .hero-eyebrow {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
    }
    .hero-title {
      font-size: clamp(2.2rem, 10.5vw, 3.1rem);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.dataset.heroReady) return;
    hero.dataset.heroReady = '1';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    // Вступительная кинематографичная анимация. На вертикальном экране
    // наплыв делаем едва заметным: при 1.45 первые пару секунд от комнаты
    // видна только середина — именно на это жаловалась Ольга.
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.set('[data-hero-clip]', { clipPath: 'inset(0 0 100% 0)' })
      .set('[data-hero-word]', { yPercent: 118 })
      .set('[data-hero-fade]', { autoAlpha: 0, y: 24 })
      .to('[data-hero-clip]', { clipPath: 'inset(0 0 0% 0)', duration: 1.5, ease: 'expo.inOut' }, 0.1)
      // Наезд был 1.45: первые две секунды кадр стоял сильно увеличенным, и
      // скриншот, снятый в этот момент, показывал совсем не то кадрирование.
      .from('[data-hero-img]', { scale: 1.05, duration: 1.6, ease: 'expo.out' }, 0.1)
      .to('[data-hero-word]', { yPercent: 0, duration: 1.15, stagger: 0.09 }, 0.55)
      .to('[data-hero-fade]', { autoAlpha: 1, y: 0, duration: 1, stagger: 0.12 }, 1.0);

    // Ken Burns и параллакс кадра убраны. Вместе они увеличивали снимок
    // почти на 10 %, и композиция переставала совпадать с той, что Ольга
    // приложила к ТЗ: подсветка и волнистый верх панели уезжали за край.
    // Кадр должен стоять ровно так, как скадрирован.

    gsap.to('.hero-inner', {
      yPercent: -12,
      autoAlpha: 0.4,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
