---
import { Image } from 'astro:assets';
import { featuredProjects, getCover } from '../../data/projects';
import { link } from '../../utils/link';
---

<section class="featured" id="projects" data-featured>
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Портфолио</p>
        <h2>Избранные<br />проекты</h2>
      </div>
      <a href={link('/projects')} class="section-link">Все проекты <span>→</span></a>
    </div>

    <div class="proj-grid">
      {
        featuredProjects.map((p) => (
          <a
            href={link(`/projects/${p.slug}`)}
            class="proj-card"
            data-cursor="view"
          >
            <div class="proj-frame" data-proj-frame>
              <div class="proj-img-move" data-proj-img>
                <Image
                  src={getCover(p.slug)}
                  alt={`${p.title} — ${p.category}, ${p.area} м²`}
                  widths={[440, 680, 900, 1160]}
                  sizes="(max-width: 1024px) 92vw, 46vw"
                  class="proj-img"
                />
              </div>
            </div>
            <div class="proj-info">
              <span class="proj-loc">
                {p.location} · {p.area} м²
              </span>
              <h3 class="proj-title serif">{p.title}</h3>
              <p class="proj-tagline">{p.tagline}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Светлая секция портфолио — плитки на белом фоне (по замечанию Ольги) */
  .featured {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: var(--c-paper);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--c-line);
  }
  .section-head h2 {
    margin-top: 0.8rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-bottom: 0.3rem;
    transition: color 0.3s var(--ease);
  }
  .section-link span {
    transition: transform 0.35s var(--ease);
  }
  .section-link:hover {
    color: var(--c-accent);
  }
  .section-link:hover span {
    transform: translateX(0.4rem);
  }

  /* Ровная сетка одинаковых плиток */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 3.4rem) clamp(1.5rem, 3vw, 2.6rem);
  }
  .proj-card {
    display: block;
  }
  .proj-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-warm);
    /* Квадрат — как на сайте Ольги (заглавные кадры разной ориентации) */
    aspect-ratio: 1 / 1;
  }
  .proj-img-move {
    position: absolute;
    inset: -12% 0;
    will-change: transform;
  }
  .proj-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .proj-card:hover .proj-img {
    transform: scale(1.04);
  }

  .proj-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.1rem;
  }
  .proj-loc {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .proj-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 400;
    transition: color 0.3s var(--ease);
  }
  .proj-card:hover .proj-title {
    color: var(--c-accent);
  }
  .proj-tagline {
    margin-top: 0.3rem;
    max-width: 44ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--c-ink-soft);
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .proj-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.8rem, 6vw, 2.6rem);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initFeatured() {
    const section = document.querySelector<HTMLElement>('[data-featured]');
    if (!section || section.dataset.ftReady) return;
    section.dataset.ftReady = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Появление кадра — clip-path раскрытие
    section.querySelectorAll<HTMLElement>('[data-proj-frame]').forEach((frame) => {
      gsap.fromTo(
        frame,
        { clipPath: 'inset(10% 6% 10% 6% round 4px)' },
        {
          clipPath: 'inset(0% 0% 0% 0% round 4px)',
          ease: 'none',
          scrollTrigger: { trigger: frame, start: 'top 92%', end: 'top 55%', scrub: 0.6 },
        }
      );
    });

    // Параллакс фотографии внутри кадра
    section.querySelectorAll<HTMLElement>('[data-proj-img]').forEach((img) => {
      gsap.fromTo(
        img,
        { yPercent: -7 },
        {
          yPercent: 7,
          ease: 'none',
          scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true },
        }
      );
    });
  }

  initFeatured();
  document.addEventListener('astro:page-load', initFeatured);
</script>
