---
import { Image } from 'astro:assets';
import { featuredProjects, getCover } from '../../data/projects';
import { link } from '../../utils/link';
---

<section class="featured" id="projects" data-featured>
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Портфолио</p>
        <h2>Избранные<br />проекты</h2>
      </div>
      <a href={link('/projects')} class="section-link">Все проекты <span>→</span></a>
    </div>

    <div class="proj-grid">
      {
        featuredProjects.map((p) => (
          <a
            href={link(`/projects/${p.slug}`)}
            class="proj-card"
            data-cursor="view"
          >
            <div class="proj-frame">
              <Image
                src={getCover(p.slug)}
                alt={`${p.title} — ${p.category}, ${p.area} м²`}
                widths={[440, 680, 900, 1160]}
                sizes="(max-width: 1024px) 92vw, 46vw"
                class="proj-img"
              />
            </div>
            <div class="proj-info">
              <span class="proj-loc">
                {p.location} · {p.area} м²
              </span>
              <h3 class="proj-title serif">{p.title}</h3>
              <p class="proj-tagline">{p.tagline}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Светлая секция портфолио — плитки на белом фоне (по замечанию Ольги) */
  .featured {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: var(--c-paper);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--c-line);
  }
  .section-head h2 {
    margin-top: 0.8rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-bottom: 0.3rem;
    transition: color 0.3s var(--ease);
  }
  .section-link span {
    transition: transform 0.35s var(--ease);
  }
  .section-link:hover {
    color: var(--c-accent);
  }
  .section-link:hover span {
    transform: translateX(0.4rem);
  }

  /* Ровная сетка одинаковых плиток */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 3.4rem) clamp(1.5rem, 3vw, 2.6rem);
  }
  /* На широком мониторе — три плитки в ряд, иначе кадры разрастаются */
  @media (min-width: 1500px) {
    .proj-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .proj-card {
    display: grid;
    grid-template-rows: auto auto;
  }
  /* Кадры разной формы — подписи всё равно выстраиваются по одной линии */
  @supports (grid-template-rows: subgrid) {
    .proj-card {
      grid-row: span 2;
      grid-template-rows: subgrid;
    }
  }
  .proj-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-warm);
    align-self: start;
    /* Квадрат — по просьбе Ольги: в натуральных пропорциях плитки выходили
       разной высоты и «прыгали». Обложки она подбирает под квадрат сама. */
    aspect-ratio: 1 / 1;
  }
  .proj-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .proj-card:hover .proj-img {
    transform: scale(1.04);
  }

  .proj-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.1rem;
  }
  .proj-loc {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .proj-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 400;
    transition: color 0.3s var(--ease);
  }
  .proj-card:hover .proj-title {
    color: var(--c-accent);
  }
  .proj-tagline {
    margin-top: 0.3rem;
    max-width: 44ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--c-ink-soft);
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .proj-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.8rem, 6vw, 2.6rem);
    }
  }
</style>

<!-- Анимации кадра убраны: и clip-path-раскрытие, и параллакс держат снимок
     подрезанным по краям, а обложки должны быть видны целиком (просьба Ольги). -->
