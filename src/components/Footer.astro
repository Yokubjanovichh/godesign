---
import { link } from '../utils/link';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-cta reveal">
      <p class="eyebrow">Один шаг к дому мечты</p>
      <a href={link('/contact')} class="footer-cta-link serif">
        Обсудить проект <span class="arrow">→</span>
      </a>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand-name serif">Ольга Горчакова</span>
        <p class="footer-tagline">
          Дизайн интерьера, который отражает вас. Москва · Зеленоград ·
          онлайн по России.
        </p>
      </div>

      <nav class="footer-col" aria-label="Навигация в подвале">
        <h3>Навигация</h3>
        <a href={link('/projects')}>Проекты</a>
        <a href={link('/about')}>Об авторе</a>
        <a href={link('/services')}>Услуги</a>
        <a href={link('/art')}>Арт-объекты</a>
      </nav>

      <div class="footer-col">
        <h3>Контакты</h3>
        <a href="mailto:ongorchakova@gmail.com">ongorchakova@gmail.com</a>
        <a href="tel:+79037168614">+7 (903) 716-86-14</a>
        <div class="footer-social">
          <a href="https://t.me/olgagorchackova" target="_blank" rel="noopener">Telegram</a>
          <a href="https://wa.me/79037168614" target="_blank" rel="noopener">WhatsApp</a>
          <a href="https://www.instagram.com/gorchakova_design/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://max.ru/join/WQkax0lz2QuQgVzJPDLR1jgZjruy-6wa-jizSKNZt1U" target="_blank" rel="noopener">Max</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Ольга Горчакова · GO design</span>
      <span class="footer-back"><a href="#top">Наверх ↑</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-bg-warm);
    padding-block: clamp(3rem, 7vw, 6rem) 2.5rem;
    margin-top: clamp(4rem, 10vw, 9rem);
  }

  /* --- Крупный CTA --- */
  .footer-cta {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--c-line);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .footer-cta-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: clamp(2.4rem, 7vw, 5rem);
    font-weight: 340;
    letter-spacing: -0.02em;
    margin-top: 1rem;
    transition: color 0.4s var(--ease);
  }
  .footer-cta-link .arrow {
    font-size: 0.7em;
    transition: transform 0.4s var(--ease);
  }
  .footer-cta-link:hover {
    color: var(--c-accent);
  }
  .footer-cta-link:hover .arrow {
    transform: translateX(0.4rem);
  }

  /* --- Сетка --- */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }
  .footer-brand .brand-name {
    font-size: 1.9rem;
    font-style: italic;
    font-weight: 500;
  }
  .footer-tagline {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--c-ink-soft);
  }
  .footer-col h3 {
    font-family: var(--f-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
    margin-bottom: 1.2rem;
  }
  .footer-col a {
    display: block;
    font-size: 0.98rem;
    margin-bottom: 0.7rem;
    transition: color 0.3s var(--ease);
  }
  /* На телефоне увеличиваем зону нажатия ссылок подвала */
  @media (max-width: 1024px), (pointer: coarse) {
    .footer-col a {
      padding-block: 0.5rem;
      margin-bottom: 0.15rem;
    }
    .footer-social a {
      padding-block: 0.55rem;
    }
  }
  .footer-col a:hover {
    color: var(--c-accent);
  }
  .footer-social {
    display: flex;
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .footer-social a {
    margin-bottom: 0;
    font-size: 0.85rem;
    color: var(--c-ink-soft);
  }

  /* --- Нижняя строка --- */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--c-line);
    font-size: 0.82rem;
    color: var(--c-ink-soft);
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-back a:hover {
    color: var(--c-accent);
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }
</style>
