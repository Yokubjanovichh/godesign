---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { link } from '../utils/link';
import { services, servicesNote } from '../data/services';
// Фото для баннера выбрала Ольга. Оригинал у неё 1280×740 (пришло через
// мессенджер, то есть уже сжатое), поэтому вверх не растягиваем — иначе
// снова появится зернистость, на которую она жаловалась в кадре героя.
import banner from '../assets/services-banner.webp';
---

<Base
  title="Услуги и цены — дизайн интерьера | Ольга Горчакова"
  description="Дизайн-проект интерьера от 4500 ₽/м², авторское сопровождение и комплектация, услуги декоратора, консультации. Прозрачные условия и договор."
>
  <section class="services">
    <div class="container">
      <!-- Баннер показан целиком, в натуральных пропорциях (просьба Ольги
           «чтобы видели», пример — interior-kod.ru) -->
      <figure class="sv-banner reveal">
        <Image
          src={banner}
          alt="Ольга Горчакова"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 94vw, 1280px"
          quality={88}
          loading="eager"
          fetchpriority="high"
          class="sv-banner-img"
        />
      </figure>

      <header class="services-head">
        <p class="eyebrow reveal">Услуги</p>
        <h1 class="reveal" data-delay="1">Как мы работаем</h1>
        <p class="services-sub reveal" data-delay="2">
          От первой консультации до готового интерьера «под ключ». Нажмите
          «плюс», чтобы раскрыть состав и этапы работы.
        </p>
      </header>

      <ol class="sv-list" data-sv-list>
        {
          services.map((s, i) => (
            <li class="sv-item reveal">
              <h2 class="sv-h">
                <button
                  type="button"
                  class="sv-head"
                  data-sv-btn
                  aria-expanded="false"
                  aria-controls={`sv-${s.slug}`}
                >
                  <span class="sv-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="sv-name">{s.name}</span>
                  <span class="sv-price">
                    {s.price}
                    {s.unit && <i>{s.unit}</i>}
                  </span>
                  <span class="sv-sign" aria-hidden="true" />
                </button>
              </h2>

              <div class="sv-panel" id={`sv-${s.slug}`} data-sv-panel>
                <div class="sv-panel-inner">
                  {s.duration && (
                    <p class="sv-duration">Продолжительность: {s.duration}</p>
                  )}
                  <p class="sv-lead">{s.lead}</p>

                  {/* Короткая услуга — текст сразу */}
                  {s.blocks?.map((b) =>
                    b.k === 'sub' ? (
                      <p class="sv-block-sub">{b.v}</p>
                    ) : b.k === 'p' ? (
                      <p class="sv-p">{b.v}</p>
                    ) : b.k === 'ul' ? (
                      <ul class="sv-ul">{b.v.map((x) => <li>{x}</li>)}</ul>
                    ) : (
                      <dl class="sv-dl">
                        {b.v.map((x) => (
                          <>
                            <dt>{x.t}</dt>
                            <dd>{x.d}</dd>
                          </>
                        ))}
                      </dl>
                    )
                  )}

                  {/* Длинная — вложенные строки с «плюсом» */}
                  {s.steps && (
                    <ol class="sv-steps">
                      {s.steps.map((st, j) => (
                        <li class="sv-step">
                          <h3 class="sv-step-h">
                            <button
                              type="button"
                              class="sv-step-head"
                              data-sv-step-btn
                              aria-expanded="false"
                              aria-controls={`sv-${s.slug}-${j}`}
                            >
                              <span class="sv-step-sign" aria-hidden="true" />
                              <span class="sv-step-name">{st.t}</span>
                            </button>
                          </h3>
                          <div
                            class="sv-step-panel"
                            id={`sv-${s.slug}-${j}`}
                            data-sv-step-panel
                          >
                            <div class="sv-step-inner">
                              {st.blocks.map((b) =>
                                b.k === 'sub' ? (
                                  <p class="sv-block-sub">{b.v}</p>
                                ) : b.k === 'p' ? (
                                  <p class="sv-p">{b.v}</p>
                                ) : b.k === 'ul' ? (
                                  <ul class="sv-ul">{b.v.map((x) => <li>{x}</li>)}</ul>
                                ) : (
                                  <dl class="sv-dl">
                                    {b.v.map((x) => (
                                      <>
                                        <dt>{x.t}</dt>
                                        <dd>{x.d}</dd>
                                      </>
                                    ))}
                                  </dl>
                                )
                              )}
                            </div>
                          </div>
                        </li>
                      ))}
                    </ol>
                  )}

                  <a href={link('/contact')} class="sv-cta">
                    Обсудить <span>→</span>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="sv-note reveal">
        <b>*</b>
        {' '}{servicesNote}
      </p>
    </div>
  </section>
</Base>

<style>
  .services {
    padding-top: clamp(7rem, 14vh, 9.5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  /* --- Баннер --- */
  .sv-banner {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .sv-banner-img {
    display: block;
    width: 100%;
    /* Не растягиваем выше исходных 1280 px: на широком мониторе контейнер
       доходит до 2600 px, и кадр рассыпался бы в зерно */
    max-width: 1280px;
    margin-inline: auto;
    height: auto; /* натуральные пропорции — кадр не обрезается */
    border-radius: var(--radius);
  }

  .services-head {
    max-width: 46ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .services-head h1 {
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    margin-top: 1rem;
  }
  .services-sub {
    margin-top: 1.4rem;
    font-size: 1.08rem;
    color: var(--c-ink-soft);
  }

  /* --- Список услуг с «плюсами» --- */
  .sv-list {
    list-style: none;
  }
  .sv-item {
    border-top: 1px solid var(--c-line);
  }
  .sv-item:last-of-type {
    border-bottom: 1px solid var(--c-line);
  }
  .sv-h {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
    line-height: inherit;
    margin: 0;
  }
  .sv-head {
    width: 100%;
    display: grid;
    grid-template-columns: 2.8rem 1fr auto 20px;
    align-items: baseline;
    gap: clamp(0.8rem, 2.4vw, 2rem);
    padding: clamp(1.5rem, 3vw, 2.3rem) 0;
    text-align: left;
    color: inherit;
  }
  /* Кнопка лежит внутри h2 и наследовала бы заголовочную гарнитуру —
     номеру и цене возвращаем текстовую */
  .sv-num {
    font-family: var(--f-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-accent);
  }
  .sv-name {
    font-family: var(--f-display);
    font-size: clamp(1.45rem, 2.7vw, 2.2rem);
    font-weight: 400;
    line-height: 1.15;
  }
  .sv-price {
    font-family: var(--f-body);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 600;
    color: var(--c-accent-deep);
    white-space: nowrap;
  }
  .sv-price i {
    font-style: normal;
    font-weight: 400;
    font-size: 0.82em;
    color: var(--c-ink-soft);
    margin-left: 0.25rem;
  }

  /* Знак «+» → «−» */
  .sv-sign {
    position: relative;
    width: 20px;
    height: 20px;
    align-self: center;
  }
  .sv-sign::before,
  .sv-sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--c-accent);
    transition: transform 0.4s var(--ease);
  }
  .sv-sign::after {
    transform: rotate(90deg);
  }
  .sv-head[aria-expanded='true'] .sv-sign::after {
    transform: rotate(0deg);
  }

  /* Раскрытие любой высоты — без магических max-height.
     По умолчанию открыто: если скрипты не отработали, текст всё равно виден.
     Свернёт его тот же CSS, но только при html.js — класс ставится инлайном
     в <head>, поэтому мигания нет. */
  .sv-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.5s var(--ease);
  }
  :global(html.js) .sv-item:not(.is-open) .sv-panel {
    grid-template-rows: 0fr;
  }
  .sv-panel-inner {
    overflow: hidden;
  }
  .sv-panel-inner > * {
    max-width: 64ch;
    margin-left: calc(2.8rem + clamp(0.8rem, 2.4vw, 2rem));
  }
  .sv-panel-inner > *:last-child {
    margin-bottom: clamp(1.8rem, 3.5vw, 2.6rem);
  }

  .sv-duration {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .sv-lead {
    margin-top: 0.6rem;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 500;
    line-height: 1.55;
  }
  /* --- Второй уровень: этапы услуги ---------------------------------- */
  .sv-steps {
    list-style: none;
    margin-top: clamp(1.4rem, 2.6vw, 2rem);
    display: grid;
    gap: 0.5rem;
  }
  /* Селектор с двумя классами — иначе .sv-panel-inner > * (та же
     специфичность, но идёт раньше… и всё равно перебивает по весу)
     оставлял строки на 64ch, и список выглядел обрубленным */
  .sv-panel-inner > .sv-steps {
    max-width: 86ch;
  }
  .sv-step-inner > * {
    max-width: 64ch;
  }
  .sv-step {
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-paper);
  }
  .sv-step-h {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
    line-height: inherit;
    margin: 0;
  }
  .sv-step-head {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    text-align: left;
    color: inherit;
  }
  .sv-step-name {
    font-family: var(--f-body);
    font-size: 1rem;
    font-weight: 500;
  }
  /* «+» → «−» */
  .sv-step-sign {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .sv-step-sign::before,
  .sv-step-sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--c-accent);
    transition: transform 0.35s var(--ease);
  }
  .sv-step-sign::after {
    transform: rotate(90deg);
  }
  .sv-step-head[aria-expanded='true'] .sv-step-sign::after {
    transform: rotate(0deg);
  }

  .sv-step-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s var(--ease);
  }
  :global(html.js) .sv-step:not(.is-open) .sv-step-panel {
    grid-template-rows: 0fr;
  }
  .sv-step-inner {
    overflow: hidden;
  }
  .sv-step-inner > * {
    padding-inline: 1.1rem;
  }
  .sv-step-inner > *:first-child {
    margin-top: 0;
    padding-top: 0.2rem;
  }
  .sv-step-inner > *:last-child {
    padding-bottom: 1.1rem;
  }
  .sv-block-sub {
    margin-top: 1.3rem;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--c-ink);
  }
  .sv-p {
    margin-top: 0.8rem;
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--c-ink-soft);
  }
  .sv-ul {
    list-style: none;
    margin-top: 0.9rem;
    display: grid;
    gap: 0.5rem;
  }
  .sv-ul li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }
  .sv-ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .sv-dl {
    margin-top: 1rem;
  }
  .sv-dl dt {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-ink);
  }
  .sv-dl dd {
    margin-top: 0.2rem;
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--c-ink-soft);
  }

  .sv-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    padding: 0.85rem 1.6rem;
    border-radius: 100px;
    border: 1px solid var(--c-ink);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      background 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .sv-cta:hover {
    background: var(--c-ink);
    color: var(--c-paper);
  }
  .sv-cta span {
    transition: transform 0.35s var(--ease);
  }
  .sv-cta:hover span {
    transform: translateX(0.35rem);
  }

  .sv-note {
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 76ch;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--c-ink-soft);
  }
  .sv-note b {
    color: var(--c-accent);
  }

  @media (max-width: 760px), (pointer: coarse) {
    /* На телефоне цена уходит под название — иначе строка не помещается */
    .sv-head {
      grid-template-columns: 2.1rem 1fr 20px;
      row-gap: 0.4rem;
    }
    .sv-name {
      grid-column: 2;
    }
    .sv-price {
      grid-column: 2;
      grid-row: 2;
    }
    .sv-sign {
      grid-column: 3;
      grid-row: 1;
    }
    .sv-panel-inner > * {
      margin-left: 0;
    }
  }
</style>

<script>
  let svAC: AbortController | null = null;

  function initServices() {
    svAC?.abort();
    const list = document.querySelector<HTMLElement>('[data-sv-list]');
    if (!list) return;
    const btns = Array.from(list.querySelectorAll<HTMLElement>('[data-sv-btn]'));
    if (!btns.length) return;

    svAC = new AbortController();
    const { signal } = svAC;

    btns.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          // Раскрыт всегда один раздел: иначе страница превращается в стену текста
          btns.forEach((b) => {
            b.setAttribute('aria-expanded', 'false');
            b.closest('.sv-item')?.classList.remove('is-open');
          });
          btn.setAttribute('aria-expanded', String(!open));
          btn.closest('.sv-item')?.classList.toggle('is-open', !open);
          if (open) return;

          // Заголовок оставляем на месте: без этого длинный раздел
          // «выталкивает» строку из-под пальца
          requestAnimationFrame(() => {
            const top = btn.getBoundingClientRect().top;
            const target = window.innerHeight * 0.18;
            if (top < target - 4 || top > target + 160) {
              const delta = top - target;
              const lenis = (window as any).__lenis;
              if (lenis?.scrollTo) lenis.scrollTo(window.scrollY + delta, { force: true });
              else window.scrollBy({ top: delta, behavior: 'smooth' });
            }
          });
        },
        { signal }
      );
    });

    // Второй уровень — этапы внутри услуги. Открываются независимо друг от
    // друга: человек читает один этап, остальные остаются свёрнутыми.
    list.querySelectorAll<HTMLElement>('[data-sv-step-btn]').forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const step = btn.closest('.sv-step');
          if (!step) return;
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          step.classList.toggle('is-open', !open);
        },
        { signal }
      );
    });
  }

  initServices();
  document.addEventListener('astro:page-load', initServices);
</script>
