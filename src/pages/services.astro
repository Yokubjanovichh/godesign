---
import Base from '../layouts/Base.astro';

const tariffs = [
  {
    name: 'Консультация',
    price: 'от 3 000 ₽',
    unit: '',
    desc: 'Разбор вашего пространства, идеи и вектор. Точка старта перед проектом.',
    points: [
      'Онлайн — 3 000 ₽ / час',
      'Зеленоград — от 6 000 ₽',
      'Москва — от 10 000 ₽',
    ],
  },
  {
    name: 'Дизайн-проект',
    price: 'от 4 500 ₽',
    unit: '/ м²',
    desc: 'Подробная рабочая документация будущего интерьера — инструкция, по которой работают строители и поставщики.',
    points: [
      'Планировочное решение',
      'Фотореалистичные визуализации',
      'Полный пакет чертежей и спецификаций',
    ],
    featured: true,
  },
  {
    name: 'Надзор и комплектация',
    price: 'от 60 000 ₽',
    unit: '/ мес',
    desc: 'Контроль реализации и подбор всех материалов, мебели и декора. Проект воплощается точно по замыслу.',
    points: [
      'Авторский надзор на объекте',
      'Подбор и закупка материалов',
      'Логистика и приёмка',
    ],
  },
];

const steps = [
  { t: 'Знакомство', d: 'Обсуждаем задачу, образ жизни и бюджет.' },
  { t: 'Планировка', d: 'Зонирование и эргономика под ваши сценарии.' },
  { t: 'Визуализации', d: 'Видите будущий интерьер до начала ремонта.' },
  { t: 'Чертежи', d: 'Полная документация для строителей.' },
  { t: 'Надзор', d: 'Контролируем воплощение до последней детали.' },
];
---

<Base
  title="Услуги и цены — дизайн интерьера | Ольга Горчакова"
  description="Дизайн-проект интерьера от 4500 ₽/м², авторский надзор и комплектация, консультации. Прозрачные условия и договор."
>
  <section class="services">
    <div class="container">
      <header class="services-head">
        <p class="eyebrow reveal">Услуги</p>
        <h1 class="reveal" data-delay="1">Как мы<br />работаем</h1>
        <p class="services-sub reveal" data-delay="2">
          От первой консультации до готового интерьера «под ключ». Прозрачные
          условия, договор и защита ваших интересов на каждом этапе.
        </p>
      </header>

      <div class="tariffs">
        {
          tariffs.map((t, i) => (
            <div
              class:list={['tariff', { 'is-featured': t.featured }, 'reveal']}
              data-delay={String((i % 3) + 1)}
            >
              <div class="tariff-top">
                <h2 class="tariff-name serif">{t.name}</h2>
                <div class="tariff-price">
                  <b>{t.price}</b>
                  {t.unit && <span>{t.unit}</span>}
                </div>
              </div>
              <p class="tariff-desc">{t.desc}</p>
              <ul class="tariff-points">
                {t.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <a href="/contact" class="tariff-cta">
                Обсудить <span>→</span>
              </a>
            </div>
          ))
        }
      </div>

      <div class="process">
        <div class="process-head reveal">
          <p class="eyebrow">Процесс</p>
          <h2>Путь проекта</h2>
        </div>
        <ol class="process-list">
          {
            steps.map((s, i) => (
              <li class="step reveal" data-delay={String((i % 4) + 1)}>
                <span class="step-num serif">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step-title serif">{s.t}</h3>
                <p class="step-desc">{s.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</Base>

<style>
  .services {
    padding-top: clamp(8rem, 16vh, 11rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .services-head {
    max-width: 46ch;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .services-head h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    margin-top: 1rem;
  }
  .services-sub {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    color: var(--c-ink-soft);
  }

  .tariffs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
  }
  .tariff {
    display: flex;
    flex-direction: column;
    padding: clamp(1.8rem, 3vw, 2.6rem);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-paper);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .tariff.is-featured {
    background: var(--c-ink);
    color: #f6efe4;
    border-color: var(--c-ink);
  }
  .tariff:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }
  .tariff-top {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--c-line);
  }
  .tariff.is-featured .tariff-top {
    border-color: rgba(246, 239, 228, 0.2);
  }
  .tariff-name {
    font-size: 1.7rem;
    font-weight: 400;
  }
  .tariff-price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .tariff-price b {
    font-family: var(--f-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--c-accent);
  }
  .tariff.is-featured .tariff-price b {
    color: #d68a5f;
  }
  .tariff-price span {
    font-size: 0.9rem;
    color: var(--c-ink-soft);
  }
  .tariff.is-featured .tariff-price span {
    color: rgba(246, 239, 228, 0.6);
  }
  .tariff-desc {
    margin-top: 1.4rem;
    font-size: 0.95rem;
    color: var(--c-ink-soft);
  }
  .tariff.is-featured .tariff-desc {
    color: rgba(246, 239, 228, 0.7);
  }
  .tariff-points {
    list-style: none;
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex-grow: 1;
  }
  .tariff-points li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.92rem;
  }
  .tariff-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .tariff-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.8rem;
    padding: 0.85rem 1.5rem;
    border-radius: 100px;
    border: 1px solid currentColor;
    align-self: flex-start;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      background 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .tariff:not(.is-featured) .tariff-cta:hover {
    background: var(--c-ink);
    color: var(--c-paper);
  }
  .tariff.is-featured .tariff-cta {
    background: #f6efe4;
    color: var(--c-ink);
    border-color: #f6efe4;
  }
  .tariff-cta span {
    transition: transform 0.35s var(--ease);
  }
  .tariff-cta:hover span {
    transform: translateX(0.35rem);
  }

  /* Процесс */
  .process {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .process-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--c-line);
  }
  .process-head h2 {
    margin-top: 0.6rem;
  }
  .process-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
  }
  .step-num {
    font-size: 1rem;
    color: var(--c-accent);
  }
  .step-title {
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0.8rem 0 0.5rem;
  }
  .step-desc {
    font-size: 0.9rem;
    color: var(--c-ink-soft);
  }

  @media (max-width: 900px) {
    .tariffs {
      grid-template-columns: 1fr;
    }
    .process-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
