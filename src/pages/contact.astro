---
import Base from '../layouts/Base.astro';
---

<Base
  title="Контакты — обсудить проект интерьера | Ольга Горчакова"
  description="Свяжитесь с Ольгой Горчаковой, чтобы обсудить дизайн интерьера. Москва, Зеленоград и онлайн по России. Ответ в течение 1–2 рабочих дней."
>
  <section class="contact">
    <div class="container contact-grid">
      <!-- Левая колонка -->
      <div class="contact-intro">
        <p class="eyebrow reveal">Контакты</p>
        <h1 class="reveal" data-delay="1">Один шаг<br />к дому <span class="serif italic accent">мечты</span></h1>
        <p class="contact-lead reveal" data-delay="2">
          Расскажите о вашем пространстве — и я свяжусь с вами в течение 1–2
          рабочих дней.
        </p>

        <div class="contact-info reveal" data-delay="3">
          <a href="mailto:ongorchakova@gmail.com" class="contact-line">
            <span>E-mail</span>
            <b>ongorchakova@gmail.com</b>
          </a>
          <a href="tel:+79037168614" class="contact-line">
            <span>Телефон</span>
            <b>+7 (903) 716-86-14</b>
          </a>
          <div class="contact-line">
            <span>Мессенджеры</span>
            <div class="contact-social">
              <a href="https://t.me/olgagorchackova" target="_blank" rel="noopener">Telegram</a>
              <a href="https://wa.me/79037168614" target="_blank" rel="noopener">WhatsApp</a>
              <a href="https://www.instagram.com/gorchakova_design/" target="_blank" rel="noopener">Instagram</a>
              <a href="https://max.ru/join/WQkax0lz2QuQgVzJPDLR1jgZjruy-6wa-jizSKNZt1U" target="_blank" rel="noopener">Max</a>
            </div>
          </div>
          <div class="contact-line">
            <span>География</span>
            <b>Москва · Зеленоград · онлайн по России</b>
          </div>
        </div>
      </div>

      <!-- Форма -->
      <div class="contact-form-wrap reveal" data-delay="2">
        <!-- Статический сайт (Surge): форма шлётся напрямую в Telegram Bot API из JS -->
        <form class="contact-form" data-contact-form method="POST">
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display: none" aria-hidden="true" />
          <div class="field">
            <label for="name">Имя</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="contact">Телефон или e-mail</label>
            <input id="contact" name="contact" type="text" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="type">Тип объекта</label>
              <select id="type" name="type">
                <option>Квартира</option>
                <option>Дом</option>
                <option>Офис / коммерция</option>
                <option>Пока не определился</option>
              </select>
            </div>
            <div class="field">
              <label for="area">Площадь, м²</label>
              <input id="area" name="area" type="number" min="1" inputmode="numeric" />
            </div>
          </div>
          <div class="field">
            <label for="city">Город</label>
            <input id="city" name="city" type="text" autocomplete="address-level2" />
          </div>
          <div class="field">
            <label for="message">Сообщение</label>
            <textarea id="message" name="message" rows="4" placeholder="Расскажите о проекте…"></textarea>
          </div>
          <button type="submit" class="form-submit">
            Отправить заявку <span>→</span>
          </button>
          <p class="form-note">Нажимая кнопку, вы соглашаетесь на обработку персональных данных.</p>
          <p class="form-result" data-form-result role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  let toastTimer: ReturnType<typeof setTimeout>;

  // Значения подставляются при сборке из .env (PUBLIC_*), в git не хранятся.
  // Сайт статический (Surge) — серверной части нет, шлём напрямую в Telegram.
  // Токен виден в JS: обязательно используйте отдельного бота для формы.
  const TG_TOKEN = import.meta.env.PUBLIC_TG_TOKEN as string | undefined;
  const TG_CHAT = import.meta.env.PUBLIC_TG_CHAT_ID as string | undefined;

  const esc = (s: FormDataEntryValue | null) =>
    String(s ?? '')
      .trim()
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;') || '—';

  async function sendToTelegram(chatId: string, text: string) {
    // form-urlencoded — «простой» запрос, без CORS-preflight; api.telegram.org
    // отдаёт Access-Control-Allow-Origin: *, поэтому ответ читается из браузера.
    const body = new URLSearchParams({
      chat_id: chatId,
      text,
      parse_mode: 'HTML',
      disable_web_page_preview: 'true',
    });
    const res = await fetch(`https://api.telegram.org/bot${TG_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    });
    return res.json();
  }

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const result = document.querySelector<HTMLElement>('[data-form-result]');
    // Защита от повторной привязки (initContactForm вызывается и напрямую,
    // и на astro:page-load) — иначе форма отправлялась дважды
    if (!form || !result || form.dataset.bound) return;
    form.dataset.bound = '1';

    // Плавающий тост сверху — виден при любом скролле и открытой клавиатуре
    const showToast = (state: 'pending' | 'ok' | 'err', text: string) => {
      result.className =
        'form-result is-showing' +
        (state === 'ok' ? ' is-ok' : state === 'err' ? ' is-err' : '');
      result.textContent = text;
      clearTimeout(toastTimer);
      if (state !== 'pending') {
        toastTimer = setTimeout(
          () => result.classList.remove('is-showing'),
          state === 'ok' ? 6000 : 9000
        );
      }
    };
    result.addEventListener('click', () => result.classList.remove('is-showing'));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Закрываем клавиатуру на телефоне, чтобы тост был виден
      (document.activeElement as HTMLElement | null)?.blur();

      const fd = new FormData(form);
      // Ловушка для ботов
      if (fd.get('botcheck')) {
        form.reset();
        showToast('ok', 'Спасибо! Заявка отправлена.');
        return;
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const text = [
        '🏠 <b>Новая заявка — GO design</b>',
        '',
        `👤 <b>Имя:</b> ${esc(fd.get('name'))}`,
        `📞 <b>Контакт:</b> ${esc(fd.get('contact'))}`,
        `🏢 <b>Тип объекта:</b> ${esc(fd.get('type'))}`,
        `📐 <b>Площадь:</b> ${esc(fd.get('area'))} м²`,
        `📍 <b>Город:</b> ${esc(fd.get('city'))}`,
        `💬 <b>Сообщение:</b> ${esc(fd.get('message'))}`,
      ].join('\n');

      if (!TG_TOKEN || !TG_CHAT) {
        showToast('err', 'Форма ещё настраивается. Напишите в Telegram или WhatsApp — ссылки слева.');
        return;
      }

      showToast('pending', 'Отправляем…');
      if (btn) btn.disabled = true;
      try {
        let tg = await sendToTelegram(TG_CHAT, text);
        // Группа превратилась в супергруппу → новый id, повторяем отправку
        if (!tg.ok && tg.parameters?.migrate_to_chat_id) {
          tg = await sendToTelegram(String(tg.parameters.migrate_to_chat_id), text);
        }
        if (tg.ok) {
          form.reset();
          showToast('ok', 'Спасибо! Заявка отправлена — свяжусь с вами в течение 1–2 рабочих дней.');
        } else {
          showToast('err', 'Не удалось отправить. Напишите в Telegram/WhatsApp или на e-mail.');
        }
      } catch {
        showToast('err', 'Ошибка сети. Напишите в Telegram/WhatsApp или на e-mail.');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact {
    padding-top: clamp(8rem, 16vh, 11rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .contact-intro h1 {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin-top: 1rem;
    line-height: 1;
  }
  .contact-lead {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    color: var(--c-ink-soft);
    max-width: 34ch;
  }
  .contact-info {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
  }
  .contact-line {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--c-line);
  }
  .contact-line:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  .contact-line span {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .contact-line b {
    font-family: var(--f-display);
    font-size: 1.2rem;
    font-weight: 400;
    transition: color 0.3s var(--ease);
  }
  a.contact-line:hover b {
    color: var(--c-accent);
  }
  .contact-social {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.2rem;
  }
  .contact-social a {
    font-size: 1rem;
    transition: color 0.3s var(--ease);
  }
  .contact-social a:hover {
    color: var(--c-accent);
  }

  /* Форма */
  .contact-form-wrap {
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 4vw, 2.8rem);
    min-width: 0;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
  }
  .field label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    font-family: var(--f-body);
    font-size: 1rem;
    color: var(--c-ink);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    /* Поля не должны распирать сетку на узких экранах */
    width: 100%;
    min-width: 0;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px rgba(169, 106, 68, 0.12);
  }
  .field textarea {
    resize: vertical;
  }
  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    padding: 1rem 1.6rem;
    background: var(--c-ink);
    color: var(--c-paper);
    border-radius: 100px;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition:
      background 0.35s var(--ease),
      gap 0.35s var(--ease);
  }
  .form-submit:hover {
    background: var(--c-accent);
    gap: 1rem;
  }
  .form-note {
    font-size: 0.76rem;
    color: var(--c-ink-soft);
    text-align: center;
  }
  /* Плавающий тост сверху по центру — виден при любом скролле/клавиатуре */
  .form-result {
    position: fixed;
    top: max(4.5rem, env(safe-area-inset-top, 0) + 4.5rem);
    left: 50%;
    z-index: 9500;
    width: min(90vw, 460px);
    margin: 0;
    padding: 1.05rem 1.35rem;
    border-radius: var(--radius-lg);
    font-size: 0.98rem;
    font-weight: 500;
    text-align: center;
    line-height: 1.5;
    background: var(--c-ink);
    color: var(--c-paper);
    box-shadow: 0 20px 50px -18px rgba(33, 28, 23, 0.65);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -14px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.45s var(--ease);
  }
  .form-result.is-showing {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .form-result.is-ok {
    background: var(--c-accent-deep);
    color: #fff;
  }
  .form-result.is-err {
    background: #8f3323;
    color: #fff;
  }
  .form-submit:disabled {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
