---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { projects, getProjectImages, getCover } from '../../data/projects';
import { link } from '../../utils/link';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const images = getProjectImages(project.slug);
const cover = getCover(project.slug);
const gallery = images.filter((img) => img !== cover);

const idx = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
const nextCover = getCover(next.slug);

const title = `${project.title} — ${project.category}, ${project.area} м² | GO design`;
---

<Base title={title} description={project.description} heroTransparent>
  <article class="project" data-project>
    <!-- Hero -->
    <header class="pj-hero">
      <div class="pj-hero-media" data-pj-clip>
        <div class="pj-hero-move" data-pj-img>
          <Image
            src={cover}
            alt={`${project.title} — ${project.category}`}
            widths={[760, 1200, 1600]}
            quality={72}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="pj-hero-img"
          />
        </div>
        <div class="pj-hero-veil"></div>
      </div>

      <div class="container pj-hero-inner">
        <a href={link('/projects')} class="pj-back" data-hero-fade>← Все проекты</a>
        <div class="pj-hero-bottom">
          <div>
            <p class="eyebrow" data-hero-fade>{project.category}</p>
            <h1 class="pj-title" data-hero-fade>{project.title}</h1>
          </div>
          <ul class="pj-facts" data-hero-fade>
            <li><span>Площадь</span><b>{project.area} м²</b></li>
            <li><span>Локация</span><b>{project.location}</b></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- Описание -->
    <section class="pj-intro">
      <div class="container pj-intro-grid">
        <p class="eyebrow reveal">О проекте</p>
        <p class="pj-desc reveal" data-delay="1">{project.description}</p>
      </div>
    </section>

    <!-- Галерея -->
    <section class="pj-gallery">
      <div class="container pj-gallery-grid">
        {
          gallery.map((img, i) => (
            <figure
              class:list={['pj-shot', img.height > img.width ? 'is-portrait' : 'is-land']}
            >
              <div
                class="pj-shot-frame"
                data-shot-frame
                style={`aspect-ratio: ${img.width} / ${img.height}`}
              >
                <Image
                  src={img}
                  alt={`${project.title} — фрагмент интерьера ${i + 2}`}
                  widths={[520, 860, 1200]}
                  quality={70}
                  sizes="(max-width: 760px) 92vw, (min-width: 1100px) 62vw, 80vw"
                  class="pj-shot-img"
                />
              </div>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- Следующий проект -->
    <a href={link(`/projects/${next.slug}`)} class="pj-next" data-cursor="view">
      <div class="pj-next-media">
        <div class="pj-next-move" data-shot-img>
          <Image
            src={nextCover}
            alt={next.title}
            widths={[760, 1200, 1600]}
            quality={72}
            sizes="100vw"
            class="pj-next-img"
          />
        </div>
        <div class="pj-next-veil"></div>
      </div>
      <div class="container pj-next-inner">
        <span class="eyebrow">Следующий проект</span>
        <h2 class="pj-next-title serif">{next.title} <span class="arr">→</span></h2>
      </div>
    </a>
  </article>
</Base>

<style>
  /* --- Hero проекта --- */
  .pj-hero {
    position: relative;
    height: 92svh;
    min-height: 34rem;
    overflow: hidden;
    color: #f6efe4;
  }
  .pj-hero-media {
    position: absolute;
    inset: 0;
  }
  .pj-hero-move {
    position: absolute;
    inset: -6% 0;
    will-change: transform;
  }
  .pj-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pj-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(18, 14, 10, 0.8) 0%,
      rgba(18, 14, 10, 0.15) 45%,
      rgba(18, 14, 10, 0.35) 100%
    );
  }
  .pj-hero-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 7rem;
    padding-bottom: clamp(2.5rem, 5vh, 4rem);
  }
  .pj-back {
    align-self: flex-start;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgba(246, 239, 228, 0.8);
    transition: color 0.3s var(--ease);
  }
  .pj-back:hover {
    color: #f6efe4;
  }
  .pj-hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .pj-title {
    font-size: clamp(2.6rem, 7vw, 6.5rem);
    font-weight: 320;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: 0.6rem;
  }
  .pj-facts {
    display: flex;
    gap: 2.6rem;
    list-style: none;
  }
  .pj-facts li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .pj-facts span {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(246, 239, 228, 0.6);
  }
  .pj-facts b {
    font-family: var(--f-display);
    font-size: 1.4rem;
    font-weight: 400;
  }

  /* --- Описание --- */
  .pj-intro {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .pj-intro-grid {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .pj-desc {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 330;
    line-height: 1.3;
    max-width: 26ch;
  }

  /* --- Галерея (кадры в натуральных пропорциях, без обрезки) --- */
  .pj-gallery {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .pj-gallery-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .pj-shot.is-land {
    width: min(72%, 1000px);
  }
  .pj-shot.is-portrait {
    width: min(46%, 560px);
  }
  .pj-shot:nth-child(even) {
    align-self: flex-end;
  }
  .pj-shot-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-warm);
    /* aspect-ratio задаётся инлайн из натуральных размеров кадра — без обрезки */
  }
  .pj-shot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Следующий проект --- */
  .pj-next {
    display: block;
    position: relative;
    height: 68svh;
    min-height: 26rem;
    overflow: hidden;
    color: #f6efe4;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .pj-next-media {
    position: absolute;
    inset: 0;
  }
  .pj-next-move {
    position: absolute;
    inset: -8% 0;
    will-change: transform;
  }
  .pj-next-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .pj-next:hover .pj-next-img {
    transform: scale(1.05);
  }
  .pj-next-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, rgba(18, 14, 10, 0.25), rgba(18, 14, 10, 0.5)),
      linear-gradient(to top, rgba(18, 14, 10, 0.5), rgba(18, 14, 10, 0.3));
  }
  .pj-next-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.8rem;
  }
  .pj-next-title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 340;
  }
  .pj-next-title .arr {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }
  .pj-next:hover .arr {
    transform: translateX(0.6rem);
  }

  @media (max-width: 760px) {
    .pj-intro-grid {
      grid-template-columns: 1fr;
    }
    .pj-shot.is-land {
      width: 100%;
      align-self: stretch;
    }
    .pj-shot.is-portrait {
      width: 84%;
    }
    .pj-facts {
      gap: 1.6rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initProject() {
    const hero = document.querySelector<HTMLElement>('.pj-hero');
    if (!hero || hero.dataset.pjReady) return;
    hero.dataset.pjReady = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Вход героя
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from('[data-pj-img]', { scale: 1.35, duration: 1.8 }, 0)
      .from(
        '[data-hero-fade]',
        { autoAlpha: 0, y: 26, duration: 1, stagger: 0.1 },
        0.5
      );

    // Параллакс героя
    gsap.to('[data-pj-img]', {
      yPercent: 14,
      ease: 'none',
      scrollTrigger: { trigger: '.pj-hero', start: 'top top', end: 'bottom top', scrub: true },
    });

    // Появление кадров галереи — мягкое раскрытие clip-path (без обрезки кадра)
    document.querySelectorAll<HTMLElement>('[data-shot-frame]').forEach((frame) => {
      gsap.fromTo(
        frame,
        { clipPath: 'inset(5% 4% 5% 4% round 4px)' },
        {
          clipPath: 'inset(0% 0% 0% 0% round 4px)',
          ease: 'none',
          scrollTrigger: { trigger: frame, start: 'top 88%', end: 'top 52%', scrub: 0.7 },
        }
      );
    });

    // Параллакс изображения «следующего проекта»
    document.querySelectorAll<HTMLElement>('[data-shot-img]').forEach((img) => {
      gsap.fromTo(
        img,
        { yPercent: -7 },
        {
          yPercent: 7,
          ease: 'none',
          scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true },
        }
      );
    });
  }

  initProject();
  document.addEventListener('astro:page-load', initProject);
</script>
