---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { projects, getCover } from '../../data/projects';
import { link } from '../../utils/link';
---

<Base
  title="Проекты — дизайн интерьера в Москве | Ольга Горчакова"
  description="Портфолио Ольги Горчаковой: квартиры, загородные дома и общественные пространства. Продуманные и живые интерьеры."
>
  <section class="projects-page">
    <div class="container">
      <header class="projects-head">
        <p class="eyebrow reveal">Портфолио · {projects.length} проектов</p>
        <h1 class="reveal" data-delay="1">Проекты</h1>
        <p class="projects-sub reveal" data-delay="2">
          Квартиры, загородные дома и общественные пространства — каждое решение
          продумано под сценарии жизни своих владельцев.
        </p>
      </header>

      <div class="projects-grid">
        {
          projects.map((p) => (
            <a href={link(`/projects/${p.slug}`)} class="pcard" data-cursor="view">
              <div class="pcard-frame" data-shot-frame>
                <div class="pcard-move" data-shot-img>
                  <Image
                    src={getCover(p.slug)}
                    alt={`${p.title} — ${p.category}, ${p.area} м²`}
                    widths={[440, 680, 900, 1160]}
                    sizes="(max-width: 760px) 92vw, 46vw"
                    class="pcard-img"
                  />
                </div>
                <span class="pcard-cat">{p.category}</span>
              </div>
              <div class="pcard-info">
                <h2 class="pcard-title serif">{p.title}</h2>
                <span class="pcard-meta">
                  {p.location} · {p.area} м²
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .projects-page {
    padding-top: clamp(8rem, 16vh, 11rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }
  .projects-head {
    max-width: 40ch;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .projects-head h1 {
    font-size: clamp(3rem, 9vw, 7rem);
    margin-top: 1rem;
  }
  .projects-sub {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    color: var(--c-ink-soft);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem) clamp(1.4rem, 3vw, 2.6rem);
  }
  .pcard:nth-child(even) {
    margin-top: clamp(0rem, 6vw, 5rem);
  }
  .pcard-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-warm);
    aspect-ratio: 4 / 3;
  }
  .pcard-move {
    position: absolute;
    inset: -10% 0;
    will-change: transform;
  }
  .pcard-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.96);
    transition:
      transform 1.2s var(--ease-out),
      filter 0.6s var(--ease);
  }
  .pcard:hover .pcard-img {
    transform: scale(1.05);
    filter: saturate(1.06);
  }
  .pcard-cat {
    position: absolute;
    top: 1.1rem;
    left: 1.2rem;
    z-index: 2;
    padding: 0.4rem 0.8rem;
    background: color-mix(in srgb, var(--c-bg) 78%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pcard-info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 1.1rem;
  }
  .pcard-title {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    font-weight: 400;
    transition: color 0.3s var(--ease);
  }
  .pcard:hover .pcard-title {
    color: var(--c-accent);
  }
  .pcard-meta {
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .pcard:nth-child(even) {
      margin-top: 0;
    }
    .pcard-info {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initProjectsList() {
    const imgs = document.querySelectorAll<HTMLElement>('.pcard [data-shot-img]');
    if (!imgs.length || imgs[0].dataset.pxReady) return;
    imgs[0].dataset.pxReady = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    imgs.forEach((img) => {
      gsap.fromTo(
        img,
        { yPercent: -6 },
        {
          yPercent: 6,
          ease: 'none',
          scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true },
        }
      );
    });
  }

  initProjectsList();
  document.addEventListener('astro:page-load', initProjectsList);
</script>
