---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { projects, getCover } from '../../data/projects';
import { link } from '../../utils/link';
---

<Base
  title="Проекты — дизайн интерьера в Москве | Ольга Горчакова"
  description="Портфолио Ольги Горчаковой: квартиры, загородные дома и общественные пространства. Продуманные и живые интерьеры."
>
  <section class="projects-page">
    <div class="container">
      <header class="projects-head">
        <p class="eyebrow reveal">Портфолио · {projects.length} проектов</p>
        <h1 class="reveal" data-delay="1">Проекты</h1>
        <p class="projects-sub reveal" data-delay="2">
          Квартиры, загородные дома и общественные пространства — каждое решение
          продумано под сценарии жизни своих владельцев.
        </p>
      </header>

      <div class="projects-grid">
        {
          projects.map((p) => (
            <a href={link(`/projects/${p.slug}`)} class="pcard" data-cursor="view">
              <div class="pcard-frame">
                <Image
                  src={getCover(p.slug)}
                  alt={`${p.title} — ${p.category}, ${p.area} м²`}
                  widths={[440, 680, 900, 1160]}
                  sizes="(max-width: 760px) 92vw, 46vw"
                  class="pcard-img"
                />
                <span class="pcard-cat">{p.category}</span>
              </div>
              <div class="pcard-info">
                <div class="pcard-head">
                  <h2 class="pcard-title serif">{p.title}</h2>
                  <span class="pcard-meta">
                    {p.location} · {p.area} м²
                  </span>
                </div>
                <p class="pcard-tagline">{p.tagline}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .projects-page {
    padding-top: clamp(8rem, 16vh, 11rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }
  .projects-head {
    max-width: 40ch;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .projects-head h1 {
    font-size: clamp(3rem, 9vw, 7rem);
    margin-top: 1rem;
  }
  .projects-sub {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    color: var(--c-ink-soft);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem) clamp(1.4rem, 3vw, 2.6rem);
  }
  /* На широком мониторе две колонки давали кадры под 900 px — вместо этого
     показываем три проекта в ряд, а на 4K — четыре */
  @media (min-width: 1500px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 2200px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* Проекты в один уровень, без шахматного смещения (по замечанию Ольги) */
  .pcard {
    display: grid;
    grid-template-rows: auto auto;
  }
  /* Кадры разной формы — подписи всё равно выстраиваются по одной линии */
  @supports (grid-template-rows: subgrid) {
    .pcard {
      grid-row: span 2;
      grid-template-rows: subgrid;
    }
  }
  .pcard-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-warm);
    align-self: start;
    /* Квадрат — по просьбе Ольги: в натуральных пропорциях плитки выходили
       разной высоты и «прыгали». Обложки она подбирает под квадрат сама. */
    aspect-ratio: 1 / 1;
  }
  .pcard-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.96);
    transition:
      transform 1.2s var(--ease-out),
      filter 0.6s var(--ease);
  }
  .pcard:hover .pcard-img {
    transform: scale(1.05);
    filter: saturate(1.06);
  }
  .pcard-cat {
    position: absolute;
    top: 1.1rem;
    left: 1.2rem;
    z-index: 2;
    padding: 0.4rem 0.8rem;
    background: color-mix(in srgb, var(--c-bg) 78%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pcard-info {
    padding-top: 1.1rem;
  }
  .pcard-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .pcard-tagline {
    margin-top: 0.5rem;
    max-width: 46ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--c-ink-soft);
  }
  .pcard-title {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    font-weight: 400;
    transition: color 0.3s var(--ease);
  }
  .pcard:hover .pcard-title {
    color: var(--c-accent);
  }
  .pcard-meta {
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .pcard-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
  }
</style>

<!-- Параллакс кадров убран: он требует обрезки по краям, а обложки теперь
     показываются целиком (просьба Ольги «чтобы видели»). -->
