---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { link } from '../utils/link';

// Изображения арт-объектов — с сайта Ольги (см. scripts/import-art.mjs)
const artImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/*.webp', {
  eager: true,
});
const img = (slug: string) =>
  Object.entries(artImages).find(([p]) => p.endsWith(`/art/${slug}.webp`))![1].default;

const artworks = [
  {
    slug: 'metal-kartina',
    name: 'Интерьерная металлизированная картина',
    type: 'Живопись',
    price: 'от 30 000 ₽',
  },
  { slug: 'panno-ryab', name: 'Панно «Рябь на воде»', type: 'Панно', price: 'от 20 000 ₽' },
  { slug: 'teksturnaya-kartina', name: 'Текстурная картина', type: 'Живопись', price: 'от 15 000 ₽' },
  {
    slug: 'keramika-seaweed',
    name: 'Авторская керамика',
    note: 'Seaweed',
    type: 'Керамика',
    price: 'по запросу',
  },
  {
    slug: 'keramika-basho',
    name: 'Авторская керамика',
    note: '古池や 蛙飛びこむ 水の音',
    quote: '«Старый пруд! Прыгнула лягушка. Всплеск воды.» — Басё',
    type: 'Керамика',
    price: 'по запросу',
  },
  {
    slug: 'keramika-kurosy',
    name: 'Авторская керамика',
    note: 'Куросы. Аполлон Пирейский',
    type: 'Керамика',
    price: 'по запросу',
  },
  { slug: 'kartina-pechat', name: 'Интерьерная картина, печать', type: 'Печать', price: 'по запросу' },
];
---

<Base
  title="Арт-объекты — авторские работы | Ольга Горчакова"
  description="Авторские арт-объекты Ольги Горчаковой: интерьерные картины, панно и керамика ручной работы для завершения пространства."
>
  <section class="art">
    <div class="container">
      <header class="art-head">
        <p class="eyebrow reveal">Арт-объекты</p>
        <h1 class="reveal" data-delay="1">Авторские<br />работы</h1>
        <p class="art-sub reveal" data-delay="2">
          Картины, панно и керамика ручной работы — финальный акцент, который
          делает интерьер завершённым и по-настоящему вашим.
        </p>
      </header>

      <ul class="art-grid">
        {
          artworks.map((a, i) => (
            <li class="art-card reveal" data-delay={String((i % 3) + 1)}>
              <div class="art-frame">
                <Image
                  src={img(a.slug)}
                  alt={a.note ? `${a.name} — ${a.note}` : a.name}
                  widths={[380, 620, 900]}
                  quality={78}
                  sizes="(max-width: 760px) 92vw, 31vw"
                  class="art-img"
                />
                <span class="art-type">{a.type}</span>
              </div>
              <div class="art-body">
                <h2 class="art-name serif">{a.name}</h2>
                {a.note && <p class="art-note">{a.note}</p>}
                {a.quote && <p class="art-quote serif italic">{a.quote}</p>}
                <span class="art-price">{a.price}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="art-cta reveal">
        <p>Хотите арт-объект под ваш интерьер?</p>
        <a href={link('/contact')} class="art-cta-link serif">Обсудить работу <span>→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .art {
    padding-top: clamp(8rem, 16vh, 11rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .art-head {
    max-width: 46ch;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .art-head h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    margin-top: 1rem;
  }
  .art-sub {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    color: var(--c-ink-soft);
  }

  .art-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.6rem, 3.4vw, 3rem) clamp(1.2rem, 2.4vw, 2.2rem);
  }
  .art-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-warm);
    aspect-ratio: 3 / 4;
  }
  .art-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  .art-card:hover .art-img {
    transform: scale(1.04);
  }
  .art-type {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.36rem 0.75rem;
    background: color-mix(in srgb, var(--c-bg) 80%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .art-body {
    padding-top: 1rem;
  }
  .art-name {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.25;
  }
  .art-note {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: var(--c-accent);
  }
  .art-quote {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--c-ink-soft);
  }
  .art-price {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--f-display);
    font-size: 1.15rem;
    color: var(--c-ink);
  }

  .art-cta {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--c-bg-warm);
    border-radius: var(--radius-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .art-cta p {
    font-size: 1.15rem;
    color: var(--c-ink-soft);
  }
  .art-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    transition: color 0.35s var(--ease);
  }
  .art-cta-link span {
    color: var(--c-accent);
    transition: transform 0.35s var(--ease);
  }
  .art-cta-link:hover span {
    transform: translateX(0.4rem);
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .art-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .art-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
