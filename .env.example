# Контактная форма → Telegram (сайт статический, серверной части нет).
# Значения попадают в клиентский JS (видны в браузере) — используйте ОТДЕЛЬНОГО
# бота, созданного в @BotFather только для формы, без прав администратора.
# Реальные значения кладите в .env (он в .gitignore, в репозиторий не попадёт).

PUBLIC_TG_TOKEN=
PUBLIC_TG_CHAT_ID=

# Выгрузка на хостинг: npm run deploy
# Доступы берутся в панели reg.ru → Хостинг → FTP-пользователи.
# Никому не пересылайте: скрипт читает их только с этой машины.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Корень сайта на хостинге. У reg.ru обычно /www/<домен>
FTP_DIR=/www/ongorchakova-design.ru
